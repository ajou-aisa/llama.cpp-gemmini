string(RANDOM LENGTH 16 run_suffix)
set(log_dir "${TEST_OUTPUT_DIR}/cycle-sim-${TEST_MODE}-${run_suffix}")
file(MAKE_DIRECTORY "${log_dir}")
set(test_env "GEMMINI_LOG_DIR=${log_dir}")
set(source_records "")
if(DEFINED TEST_SOURCE_ROOTS)
    # ExSIA fixtures record the checkouts they ran from: the llama commit and the SHA256 of
    # "<llama HEAD> <IM2P.sim HEAD>", read when the test runs (not when it was configured).
    string(REPLACE "|" ";" source_roots "${TEST_SOURCE_ROOTS}")
    set(heads "")
    foreach(root IN LISTS source_roots)
        execute_process(COMMAND git -C "${root}" rev-parse HEAD RESULT_VARIABLE git_result
            OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(NOT git_result EQUAL 0 OR NOT head MATCHES "^[0-9a-f]+$")
            message(FATAL_ERROR "source identity: ${root} is not a git checkout")
        endif()
        execute_process(COMMAND git -C "${root}" status --porcelain --untracked-files=no
            OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        set(tracked_changes false)
        if(NOT changes STREQUAL "")
            set(tracked_changes true)
        endif()
        list(APPEND heads "${head}")
        list(APPEND source_records
            "{\"root\":\"${root}\",\"head\":\"${head}\",\"tracked_changes\":${tracked_changes}}")
    endforeach()
    list(GET heads 0 source_commit)
    list(JOIN heads " " manifest_text)
    string(SHA256 manifest_sha256 "${manifest_text}")
    list(APPEND test_env "IM2P_FIXTURE_SOURCE_COMMIT=${source_commit}"
        "IM2P_FIXTURE_SOURCE_MANIFEST_SHA256=${manifest_sha256}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${test_env} "${TEST_EXECUTABLE}" "${TEST_MODE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(WRITE "${log_dir}/stdout.log" "${output}")
file(WRITE "${log_dir}/stderr.log" "${error}")
message(STATUS "Cycle-sim trace fixture: ${log_dir}/npu-cycle-trace.jsonl")

# Every run leaves ctest-record.json beside its logs: command, environment, exit code, executable
# and source identity, and the verdict of this driver.
function(finish verdict detail)
    file(SHA256 "${TEST_EXECUTABLE}" executable_sha256)
    list(JOIN source_records "," sources)
    set(environment "")
    foreach(entry IN LISTS test_env)
        string(REGEX REPLACE "^([^=]+)=(.*)$" "\"\\1\":\"\\2\"" pair "${entry}")
        list(APPEND environment "${pair}")
    endforeach()
    list(JOIN environment "," environment)
    string(REPLACE "\\" "\\\\" detail "${detail}")
    string(REPLACE "\"" "\\\"" detail "${detail}")
    string(REPLACE "\n" "\\n" detail "${detail}")
    file(WRITE "${log_dir}/ctest-record.json"
        "{\"mode\":\"${TEST_MODE}\",\"command\":[\"${TEST_EXECUTABLE}\",\"${TEST_MODE}\"],"
        "\"environment\":{${environment}},\"exit_code\":\"${result}\","
        "\"executable_sha256\":\"${executable_sha256}\",\"sources\":[${sources}],"
        "\"log_dir\":\"${log_dir}\",\"verdict\":\"${verdict}\",\"detail\":\"${detail}\"}\n")
    if(NOT verdict STREQUAL "PASS")
        message(FATAL_ERROR "${detail}")
    endif()
endfunction()

if(NOT result EQUAL 0)
    finish(FAIL "${output}\n${error}")
endif()
set(cycle_log "${log_dir}/cycle-log.jsonl")
set(npu_trace "${log_dir}/npu-cycle-trace.jsonl")
if(TEST_MODE MATCHES "^exsia-")
    # An ExSIA mode passes only on its own result lines and with both logs present.
    set(markers "CPU_FUNCTIONAL_DISPATCH_PASS mode=${TEST_MODE} ")
    if(TEST_MODE MATCHES "^exsia-paired-(pipeline|unsupported)$")
        list(APPEND markers "PAIRED_TRACE_PASS ")
    elseif(TEST_MODE STREQUAL "exsia-paired-malformed")
        list(APPEND markers "PAIRED_MALFORMED_PASS refused=1 ")
    endif()
    foreach(marker IN LISTS markers)
        string(FIND "${output}" "${marker}" found)
        if(found EQUAL -1)
            finish(FAIL "missing result line '${marker}'\n${output}\n${error}")
        endif()
    endforeach()
    foreach(log IN ITEMS "${npu_trace}" "${cycle_log}")
        if(NOT EXISTS "${log}")
            finish(FAIL "missing log ${log}")
        endif()
    endforeach()
endif()
if(EXISTS "${cycle_log}")
    file(READ "${cycle_log}" cycle_records)
    if(cycle_records MATCHES "\"record_type\":\"NPU_OPERATOR_SEGMENT\"")
        finish(FAIL "CPU-functional collection emitted legacy online NPU timing")
    endif()
    file(STRINGS "${cycle_log}" potal_records REGEX "\"duration_role\":\"POTAL_HOST\"")
    foreach(record IN LISTS potal_records)
        if(NOT record MATCHES "\"interval_class\":\"CANONICAL_ADDITIVE\"")
            finish(FAIL "PoTal host duration lacks canonical additive classification")
        endif()
    endforeach()
    if(EXISTS "${npu_trace}")
        file(READ "${npu_trace}" npu_records)
        if(npu_records MATCHES "\"stage_name\":\"im2p.output_reconstruction\"" AND
           NOT cycle_records MATCHES "\"op\":\"im2p.output_reconstruction\"[^\n]*\"interval_class\":\"CANONICAL_ADDITIVE\"[^\n]*\"duration_role\":\"POTAL_HOST\"")
            finish(FAIL "output reconstruction host stage lacks canonical measured cost")
        endif()
    endif()
endif()
execute_process(COMMAND "${TEST_PYTHON}"
    "${CMAKE_CURRENT_LIST_DIR}/check-cycle-sim-host-stages.py" "${npu_trace}" "${cycle_log}"
    RESULT_VARIABLE host_result OUTPUT_VARIABLE host_output ERROR_VARIABLE host_error)
file(WRITE "${log_dir}/host-stages.log" "${host_output}${host_error}")
if(NOT host_result EQUAL 0)
    finish(FAIL "${host_output}\n${host_error}")
endif()
finish(PASS "")
