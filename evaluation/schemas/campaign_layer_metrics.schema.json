{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["model", "precision", "dim", "manifest_sha256", "input_sha256", "aggregation", "layers"],
  "additionalProperties": false,
  "properties": {
    "model": {"type": "string", "minLength": 1},
    "precision": {"enum": ["A4W4", "A8W8"]},
    "dim": {"enum": [16, 32, 64]},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "aggregation": {"const": "integer-sum-before-division"},
    "layers": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["layer", "manifest_sha256", "input_sha256"],
      "properties": {"layer": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    }}
  }
}
