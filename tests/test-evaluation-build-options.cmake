if(NOT DEFINED TEST_SOURCE_DIR)
    message(FATAL_ERROR "TEST_SOURCE_DIR required")
endif()
find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(resolver "${TEST_SOURCE_DIR}/scripts/im2p-build-options.py")
execute_process(COMMAND env -i "PATH=$ENV{PATH}" "${Python3_EXECUTABLE}" -B
    "${resolver}" unused build-arm64.sh --
    RESULT_VARIABLE missing_default_result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(missing_default_result EQUAL 0)
    message(FATAL_ERROR "Resolver inferred a Gemmini default from the script filename")
endif()
foreach(flag IN ITEMS GGML_GEMMINI_ACT_QUANT_METRICS GGML_GEMMINI_RESIDUAL_METRICS
        GGML_GEMMINI_ACT_METRICS GGML_GEMMINI_SCALE_METRICS)
    foreach(value IN ITEMS 2 ON -1 true)
        execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${resolver}"
            unused build-arm64.sh GGML_GEMMINI=OFF -- "-D${flag}=${value}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(result EQUAL 0 OR NOT error MATCHES "${flag} must be 0 or 1")
            message(FATAL_ERROR "invalid ${flag}=${value} admitted: ${output} ${error}")
        endif()
    endforeach()
endforeach()

foreach(scenario IN ITEMS derived default-env cli)
    set(environment)
    set(arguments -DLOG_CYCLE=1)
    set(expected 1)
    if(scenario STREQUAL "default-env")
        set(environment GGML_CPU_CYCLE_LOG_DEFAULT=0)
        set(expected 0)
    elseif(scenario STREQUAL "cli")
        set(environment GGML_CPU_CYCLE_LOG=0)
        set(arguments -DLOG_CYCLE=0 -DGGML_CPU_CYCLE_LOG:STRING=1)
    endif()
    execute_process(COMMAND env -i "PATH=$ENV{PATH}" ${environment}
        "${Python3_EXECUTABLE}" -B "${resolver}" unused renamed-script.sh
        GGML_GEMMINI=OFF LOG_CYCLE=0 GGML_CPU_CYCLE_LOG=0 -- ${arguments}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "CPU log ${scenario} resolution failed: ${error}")
    endif()
    string(REGEX MATCH "IM2P_EFFECTIVE_CONFIG=([^\n]+)" summary "${error}")
    string(JSON actual GET "${CMAKE_MATCH_1}" effective GGML_CPU_CYCLE_LOG)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "CPU log ${scenario}=${actual}, expected ${expected}")
    endif()
endforeach()

foreach(source IN ITEMS typed-cli environment default-environment)
    foreach(value IN ITEMS ON OFF TRUE FALSE YES NO Y N 1 0)
        set(environment)
        set(arguments)
        if(value MATCHES "^(ON|TRUE|YES|Y|1)$")
            set(expected 1)
            set(log_cycle 0)
        else()
            set(expected 0)
            set(log_cycle 1)
        endif()
        if(source STREQUAL "typed-cli")
            set(arguments "-DGGML_CPU_CYCLE_LOG:BOOL=${value}")
        elseif(source STREQUAL "environment")
            set(environment "GGML_CPU_CYCLE_LOG=${value}")
        else()
            set(environment "GGML_CPU_CYCLE_LOG_DEFAULT=${value}")
        endif()
        execute_process(COMMAND env -i "PATH=$ENV{PATH}" ${environment}
            "${Python3_EXECUTABLE}" -B "${resolver}" unused renamed-script.sh
            GGML_GEMMINI=OFF "LOG_CYCLE=${log_cycle}" GGML_CPU_CYCLE_LOG=0 -- ${arguments}
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "CPU BOOL ${source}/${value} rejected: ${error}")
        endif()
        string(REGEX MATCH "IM2P_EFFECTIVE_CONFIG=([^\n]+)" summary "${error}")
        set(config "${CMAKE_MATCH_1}")
        string(JSON actual GET "${config}" effective GGML_CPU_CYCLE_LOG)
        string(JSON actual_log GET "${config}" effective LOG_CYCLE)
        if(NOT actual STREQUAL expected OR NOT actual_log STREQUAL log_cycle)
            message(FATAL_ERROR "CPU BOOL ${source}/${value} changed independent log policy: ${config}")
        endif()
    endforeach()
endforeach()
foreach(act IN ITEMS 0 1)
    foreach(res IN ITEMS 0 1)
        execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${resolver}"
            unused build-arm64.sh GGML_GEMMINI=OFF LOG_CYCLE=0 CYCLE_SIM=0
            CYCLE_DETAIL=0 GGML_CPU_CYCLE_LOG=0 --
            "-DGGML_GEMMINI_ACT_QUANT_METRICS=${act}"
            "-DGGML_GEMMINI_RESIDUAL_METRICS=${res}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "independent metric options rejected: ${error}")
        endif()
        foreach(pair IN ITEMS "GGML_GEMMINI_ACT_QUANT_METRICS=${act}"
                "GGML_GEMMINI_RESIDUAL_METRICS=${res}" "LOG_CYCLE=0"
                "CYCLE_SIM=0" "CYCLE_DETAIL=0" "GGML_CPU_CYCLE_LOG=0")
            string(FIND "${output}" "-D${pair}" found)
            if(found EQUAL -1)
                message(FATAL_ERROR "resolved option absent or changed: ${pair}")
            endif()
        endforeach()
    endforeach()
endforeach()

foreach(alias IN ITEMS 0 1)
    foreach(canonical IN ITEMS 0 1)
        execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${resolver}"
            unused renamed-script.sh GGML_GEMMINI=OFF --
            "-DGGML_GEMMINI_ACT_METRICS=${alias}"
            "-DGGML_GEMMINI_ACT_QUANT_METRICS=${canonical}"
            -DGGML_GEMMINI_SCALE_METRICS=1
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "metric alias combination rejected: ${error}")
        endif()
        if(alias OR canonical)
            set(expected 1)
        else()
            set(expected 0)
        endif()
        string(REGEX MATCH "IM2P_EFFECTIVE_CONFIG=([^\n]+)" summary "${error}")
        string(JSON actual GET "${CMAKE_MATCH_1}" effective GGML_GEMMINI_ACT_QUANT_METRICS)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "ACT alias=${alias}/canonical=${canonical} resolved ${actual}")
        endif()
    endforeach()
endforeach()

foreach(arguments IN ITEMS
        "-DCYCLE_DETAIL=1;-DLOG_CYCLE=0"
        "-DGGML_GEMMINI_EXSIA_PROFILE_SCOPE=BAD"
        "-DGGML_GEMMINI_EXSIA_PROFILE_SCOPE=STAGE;-DCYCLE_DETAIL=0"
        "-DGGML_GEMMINI_EXECUTION_BACKEND=FPGA_UART"
        "-DCMAKE_TOOLCHAIN_FILE:FILEPATH=/unused/toolchain.cmake")
    execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${resolver}"
        unused build-arm64.sh GGML_GEMMINI=OFF -- ${arguments}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(result EQUAL 0)
        message(FATAL_ERROR "invalid OFF configuration admitted: ${arguments}")
    endif()
endforeach()

foreach(scenario IN ITEMS default-env ordinary-env typed-cli alias-higher canonical-higher conflict-cli conflict-env conflict-default)
    set(environment "LOG_DEBUG_DEFAULT=1")
    set(arguments)
    set(expected 1)
    set(dim 16)
    if(scenario STREQUAL "ordinary-env" OR scenario STREQUAL "typed-cli")
        list(APPEND environment LOG_DEBUG=0)
        set(expected 0)
    endif()
    if(scenario STREQUAL "typed-cli")
        set(arguments -DLOG_DEBUG:BOOL=0 -DLOG_DEBUG:STRING=1
            -DUPSTREAM_VALUE:STRING=first "-DUPSTREAM_VALUE:PATH=last value" -Wno-dev)
        set(expected 1)
    elseif(scenario STREQUAL "alias-higher")
        list(APPEND environment GGML_GEMMINI_DIM_DEFAULT=16 IM2P_DIM=32)
        set(dim 32)
    elseif(scenario STREQUAL "canonical-higher")
        list(APPEND environment IM2P_DIM_DEFAULT=32 GGML_GEMMINI_DIM=64)
        set(dim 64)
    elseif(scenario STREQUAL "conflict-cli")
        set(arguments -DIM2P_DIM=32 -DGGML_GEMMINI_DIM=64)
    elseif(scenario STREQUAL "conflict-env")
        list(APPEND environment IM2P_DIM=32 GGML_GEMMINI_DIM=64)
    elseif(scenario STREQUAL "conflict-default")
        list(APPEND environment IM2P_DIM_DEFAULT=32 GGML_GEMMINI_DIM_DEFAULT=64)
    endif()
    execute_process(COMMAND env -i "PATH=$ENV{PATH}" ${environment}
        "${Python3_EXECUTABLE}" -B "${resolver}" unused renamed-script.sh
        GGML_GEMMINI=OFF GGML_GEMMINI_DIM=16 LOG_DEBUG=0 -- ${arguments}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(scenario MATCHES "^conflict")
        if(result EQUAL 0)
            message(FATAL_ERROR "${scenario} accepted contradictory dimensions")
        endif()
        continue()
    endif()
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${scenario} resolution failed: ${error}")
    endif()
    string(REGEX MATCH "IM2P_EFFECTIVE_CONFIG=([^\n]+)" summary "${error}")
    set(config "${CMAKE_MATCH_1}")
    string(JSON log_debug GET "${config}" effective LOG_DEBUG)
    string(JSON dimension GET "${config}" effective GGML_GEMMINI_DIM)
    if(NOT log_debug STREQUAL expected OR NOT dimension STREQUAL dim)
        message(FATAL_ERROR "${scenario} selected incorrect precedence: ${config}")
    endif()
    string(JSON count LENGTH "${config}" cmake_args)
    math(EXPR last "${count} - 1")
    set(keys)
    set(argv)
    foreach(index RANGE 0 ${last})
        string(JSON argument GET "${config}" cmake_args ${index})
        list(APPEND argv "${argument}")
        if(argument MATCHES "^-D([^:=]+)(:[^=]+)?=")
            set(key "${CMAKE_MATCH_1}")
            if(key IN_LIST keys)
                message(FATAL_ERROR "${scenario} emitted duplicate ${key}: ${config}")
            endif()
            list(APPEND keys "${key}")
        endif()
    endforeach()
    if(scenario STREQUAL "typed-cli")
        foreach(required IN ITEMS -DLOG_DEBUG:STRING=1 "-DUPSTREAM_VALUE:PATH=last value" -Wno-dev)
            if(NOT required IN_LIST argv)
                message(FATAL_ERROR "typed CLI lost ${required}: ${config}")
            endif()
        endforeach()
    endif()
endforeach()
