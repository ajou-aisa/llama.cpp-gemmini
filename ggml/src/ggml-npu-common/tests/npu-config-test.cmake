# Configure-time contract of cmake/npu-config.cmake: valid NPU_* geometries
# produce the expected derived values; unsupported ones fail with a specific
# error. Every case configures an API-only tree (no compilation).
# Inputs: -DSOURCE_DIR -DWORK_DIR -DGENERATOR
cmake_minimum_required(VERSION 3.19)

set(_failures 0)
set(_gemmini -DGGML_NPU=GEMMINI -DNPU_API_ONLY=ON -DNPU_PRECISION=INT8 -DNPU_D=16 -DNPU_SPAD_BANKS=4
             -DNPU_SPAD_BANK_ROWS=4096 -DNPU_ACC_BANKS=2 -DNPU_ACC_ROWS=1024 -DNPU_DMA_MAX_BYTES=64
             -DNPU_TRANSPORT=REFERENCE)
set(_potal -DGGML_NPU=POTAL -DNPU_API_ONLY=ON -DNPU_PRECISION=INT8 -DNPU_D=32 -DNPU_SPAD_BANKS=4
           -DNPU_SPAD_BANK_ROWS=2048 -DNPU_ACC_BANKS=2 -DNPU_ACC_ROWS=512 -DNPU_INDEX_ENTRIES=64
           -DNPU_SCALE_ENTRIES=256 -DNPU_DMA_MAX_BYTES=64 -DNPU_TRANSPORT=REFERENCE)

function(_configure name out_rc out_log)
    set(dir "${WORK_DIR}/${name}")
    file(REMOVE_RECURSE "${dir}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${SOURCE_DIR}" -B "${dir}" -G "${GENERATOR}" ${ARGN}
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    set(${out_rc} ${rc} PARENT_SCOPE)
    set(${out_log} "${out}${err}" PARENT_SCOPE)
endfunction()

function(_fail what)
    message(SEND_ERROR "FAIL ${what}")
    math(EXPR n "${_failures} + 1")
    set(_failures ${n} PARENT_SCOPE)
endfunction()

# expect_ok(name "<json key path>=<value>;..." args...)
macro(expect_ok name checks)
    _configure(${name} _rc _log ${ARGN})
    if(NOT _rc EQUAL 0)
        _fail("${name}: configure failed\n${_log}")
    else()
        file(READ "${WORK_DIR}/${name}/generated/npu_config.json" _json)
        foreach(_check IN ITEMS ${checks})
            string(REPLACE "=" ";" _kv "${_check}")
            list(GET _kv 0 _path)
            list(GET _kv 1 _expected)
            string(REPLACE "." ";" _keys "${_path}")
            string(JSON _value ERROR_VARIABLE _jerr GET "${_json}" ${_keys})
            if(_jerr OR NOT "${_value}" STREQUAL "${_expected}")
                _fail("${name}: ${_path}=${_value} expected ${_expected} ${_jerr}")
            endif()
        endforeach()
    endif()
endmacro()

macro(expect_error name regex)
    _configure(${name} _rc _log ${ARGN})
    if(_rc EQUAL 0 OR NOT _log MATCHES "${regex}")
        _fail("${name}: expected configure error matching '${regex}'\n${_log}")
    endif()
endmacro()

expect_ok(gemmini-d16 "architecture=GEMMINI;geometry.acc_bank_rows=512;geometry.spad_total_rows=16384;geometry.spad_capacity_bytes=262144;geometry.acc_capacity_bytes=65536;dma.max_block_len=4;dma.max_block_len_acc=1" ${_gemmini})
expect_ok(gemmini-d16-small-spad "geometry.spad_bank_rows=2048;geometry.acc_rows=512;geometry.acc_bank_rows=256" ${_gemmini} -DNPU_SPAD_BANK_ROWS=2048 -DNPU_ACC_ROWS=512)
expect_ok(gemmini-d32 "geometry.d=32;geometry.spad_row_bytes=32;geometry.acc_row_bytes=128;dma.max_block_len=2;dma.max_block_len_acc=1" ${_gemmini} -DNPU_D=32 -DNPU_SPAD_BANK_ROWS=2048 -DNPU_ACC_ROWS=512)
expect_ok(gemmini-baseline-reference "transport=REFERENCE;matmul_algorithm=BASELINE;execution_policy=CPU" ${_gemmini})
expect_ok(gemmini-pb-reference "transport=REFERENCE;matmul_algorithm=PARTIAL_SUM;execution_policy=WS;geometry.d=32" ${_gemmini} -DNPU_D=32 -DNPU_MATMUL_ALGORITHM=PARTIAL_SUM)
expect_ok(gemmini-pb-legacy "matmul_algorithm=PARTIAL_SUM;execution_policy=WS" ${_gemmini} -DNPU_D=32 -DGGML_GEMMINI_PB=ON)
expect_error(gemmini-pb-d16 "PARTIAL_SUM requires Gemmini INT8 D32" ${_gemmini} -DNPU_MATMUL_ALGORITHM=PARTIAL_SUM)
expect_error(gemmini-pb-cpu "GGML_GEMMINI_OPTION=CPU conflicts" ${_gemmini} -DNPU_D=32 -DNPU_MATMUL_ALGORITHM=PARTIAL_SUM -DGGML_GEMMINI_OPTION=CPU)
expect_error(gemmini-pb-conflict "GGML_GEMMINI_PB=ON conflicts" ${_gemmini} -DNPU_MATMUL_ALGORITHM=BASELINE -DGGML_GEMMINI_PB=ON)
expect_error(gemmini-algorithm "NPU_MATMUL_ALGORITHM='OTHER' is not supported" ${_gemmini} -DNPU_MATMUL_ALGORITHM=OTHER)
expect_error(potal-algorithm "applies to GEMMINI only" ${_potal} -DNPU_MATMUL_ALGORITHM=PARTIAL_SUM)
expect_ok(potal-int8-d32 "architecture=POTAL;potal.index_entries=64;potal.scale_entries=256;geometry.acc_bank_rows=256" ${_potal})
expect_ok(potal-int8-d32-index128 "potal.index_entries=128" ${_potal} -DNPU_INDEX_ENTRIES=128)
expect_ok(potal-int4-d32 "precision.input_bits=4;precision.packing_abi=1;geometry.spad_row_bytes=16;geometry.spad_capacity_bytes=131072;dma.max_block_len=4" ${_potal} -DNPU_PRECISION=INT4)

expect_error(missing-acc-rows "requires NPU_ACC_ROWS" ${_gemmini} -DNPU_ACC_ROWS=)
expect_error(acc-banks-not-pow2 "NPU_ACC_BANKS=3 must be a power of two" ${_gemmini} -DNPU_ACC_BANKS=3)
expect_error(non-numeric "must be a positive decimal integer" ${_gemmini} -DNPU_D=16x)
expect_error(gemmini-int4 "NPU_PRECISION='INT4' is not supported" ${_gemmini} -DNPU_PRECISION=INT4)
expect_error(mixed-precision "GGML_GEMMINI_ACTIVATION_BITS=16 needs NPU_PRECISION=INT16" ${_gemmini} -DGGML_GEMMINI_ACTIVATION_BITS=16)
expect_error(gemmini-index "NPU_INDEX_ENTRIES=32 does not apply to GEMMINI" ${_gemmini} -DNPU_INDEX_ENTRIES=32)
expect_error(capacity "cannot hold one double-buffered" ${_gemmini} -DNPU_SPAD_BANK_ROWS=4)
expect_error(dma "NPU_DMA_MAX_BYTES=128 is unsupported" ${_gemmini} -DNPU_DMA_MAX_BYTES=128)
expect_error(legacy-dim-conflict "GGML_GEMMINI_DIM=32 conflicts" ${_gemmini} -DGGML_GEMMINI_DIM=32)
expect_error(legacy-sdk "GEMMINI_SW_PATH is no longer used" ${_gemmini} -DGEMMINI_SW_PATH=${WORK_DIR})
expect_error(transport-rpc "NPU_TRANSPORT=RPC is not implemented" ${_gemmini} -DNPU_TRANSPORT=RPC)
if(NOT CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "riscv64")
    expect_error(rocc-host "needs a riscv64 target" ${_gemmini} -DNPU_TRANSPORT=ROCC)
endif()
expect_error(potal-scale "NPU_SCALE_ENTRIES=128 is unsupported" ${_potal} -DNPU_SCALE_ENTRIES=128)
expect_error(potal-index-small "must hold at least one DIM=32 K pass" ${_potal} -DNPU_INDEX_ENTRIES=16)
expect_error(potal-banks "supports NPU_SPAD_BANKS=4 and NPU_ACC_BANKS=2 only" ${_potal} -DNPU_ACC_BANKS=4)
expect_error(potal-int4-d16 "INT4 packing ABI 1 is defined for D=32 only" ${_potal} -DNPU_PRECISION=INT4 -DNPU_D=16 -DNPU_SPAD_BANK_ROWS=4096 -DNPU_ACC_ROWS=1024)
expect_error(potal-w4a4-conflict "GGML_POTAL_W4A4=OFF conflicts" ${_potal} -DNPU_PRECISION=INT4 -DGGML_POTAL_W4A4=OFF)
expect_error(none-with-params "NPU_D=16 needs GGML_NPU=GEMMINI or POTAL" -DGGML_NPU=NONE -DNPU_D=16)

if(_failures GREATER 0)
    message(FATAL_ERROR "npu-config-test: ${_failures} failure(s)")
endif()
message(STATUS "NPU_CONFIG_TEST PASS")
