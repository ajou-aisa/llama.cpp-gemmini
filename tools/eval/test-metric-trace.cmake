if(NOT DEFINED WORKLOAD_DIR)
    message(FATAL_ERROR "WORKLOAD_DIR must name a completed native metric workload")
endif()
file(READ "${WORKLOAD_DIR}/workload.json" workload)
string(JSON kind GET "${workload}" workload)
string(JSON complete GET "${workload}" complete)
string(JSON count LENGTH "${workload}" chunks)
if(NOT kind STREQUAL "METRIC_PREFILL_256" OR NOT complete OR count LESS 1)
    message(FATAL_ERROR "expected a complete nonempty METRIC_PREFILL_256 workload")
endif()
file(GLOB target_traces "${WORKLOAD_DIR}/chunk-*/npu-cycle-trace.jsonl")
if(target_traces)
    message(FATAL_ERROR "statistics-only workload emitted auxiliary target trace: ${target_traces}")
endif()
string(JSON enabled GET "${workload}" target_trace_collection_enabled)
string(JSON reason GET "${workload}" target_trace_collection_reason)
if(enabled OR NOT reason STREQUAL "metric_statistics_only")
    message(FATAL_ERROR "statistics manifest must declare disabled target trace collection")
endif()
if(DEFINED EXPECTED_LOGITS_FINGERPRINT)
    string(JSON fingerprint GET "${workload}" chunks 0 logits_fingerprint)
    if(NOT fingerprint STREQUAL EXPECTED_LOGITS_FINGERPRINT)
        message(FATAL_ERROR "logits fingerprint changed: ${fingerprint}")
    endif()
endif()
message(STATUS "metric statistics preserve logits without auxiliary target traces")
