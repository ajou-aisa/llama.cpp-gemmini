{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["manifest_sha256", "trace_sha256", "cycle_library_sha256", "unit", "dense_cycles", "residual_cycles",
    "scu_cycles", "resource_ready_cycles", "fragment_count", "submission_count", "logical_work_count",
    "load_request_count", "store_request_count", "scale_request_count", "cycle_count_is_not_latency_ms"],
  "properties": {
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trace_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cycle_library_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unit": {"const": "cycles"},
    "cycle_count_is_not_latency_ms": {"const": true},
    "dense_cycles": {"type": "integer", "minimum": 0},
    "residual_cycles": {"type": "integer", "minimum": 0},
    "scu_cycles": {"type": ["integer", "null"], "minimum": 0},
    "resource_ready_cycles": {"type": "integer", "minimum": 0},
    "fragment_count": {"type": "integer", "minimum": 0},
    "submission_count": {"type": "integer", "minimum": 0},
    "logical_work_count": {"type": "integer", "minimum": 1}
  }
}
