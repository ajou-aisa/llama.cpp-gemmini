if(NOT DEFINED TEST_BINARY OR NOT DEFINED TEST_ROOT)
    message(FATAL_ERROR "TEST_BINARY and TEST_ROOT required")
endif()
string(RANDOM LENGTH 20 suffix)
set(output "${TEST_ROOT}/metric-sink-${suffix}")
execute_process(COMMAND "${TEST_BINARY}" "${output}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "metric sink test failed: ${result}; output ${output}")
endif()
