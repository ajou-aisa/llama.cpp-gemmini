if(NOT DEFINED TEST_SOURCE_DIR)
    message(FATAL_ERROR "TEST_SOURCE_DIR required")
endif()
if(NOT DEFINED TEST_GENERATOR)
    set(TEST_GENERATOR Ninja)
endif()
set(root "${CMAKE_CURRENT_BINARY_DIR}/evaluation-build-options")
file(MAKE_DIRECTORY "${root}/source")
set(source [=[
cmake_minimum_required(VERSION 3.19)
project(option_contract NONE)
include("@SOURCE@/cmake/npu-config.cmake")
include("@SOURCE@/cmake/ggml-gemmini-options.cmake")
if(NOT DEFINED GGML_CPU_CYCLE_LOG)
    set(GGML_CPU_CYCLE_LOG "${LOG_CYCLE}")
endif()
file(WRITE "${CMAKE_BINARY_DIR}/resolved.cmake"
    "set(ACT ${GGML_GEMMINI_ACT_QUANT_METRICS})\nset(RES ${GGML_GEMMINI_RESIDUAL_METRICS})\nset(CPU ${GGML_CPU_CYCLE_LOG})\nset(LOG ${LOG_CYCLE})\n")
]=])
string(REPLACE "@SOURCE@" "${TEST_SOURCE_DIR}" source "${source}")
file(WRITE "${root}/source/CMakeLists.txt" "${source}")
function(run_case name expected_success)
    set(dir "${root}/${name}")
    file(REMOVE_RECURSE "${dir}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -G "${TEST_GENERATOR}" -S "${root}/source" -B "${dir}"
        -DGGML_NPU=NONE ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    set(CASE_DIAGNOSTIC "${output}\n${error}" PARENT_SCOPE)
    if(expected_success AND NOT result EQUAL 0)
        message(FATAL_ERROR "${name} rejected: ${output} ${error}")
    elseif(NOT expected_success AND result EQUAL 0)
        message(FATAL_ERROR "${name} unexpectedly accepted")
    endif()
    if(expected_success)
        include("${dir}/resolved.cmake")
        foreach(key IN ITEMS ACT RES CPU LOG)
            set(${key} "${${key}}" PARENT_SCOPE)
        endforeach()
    endif()
endfunction()
foreach(flag IN ITEMS GGML_GEMMINI_ACT_QUANT_METRICS GGML_GEMMINI_RESIDUAL_METRICS GGML_GEMMINI_ACT_METRICS GGML_GEMMINI_SCALE_METRICS)
    foreach(value IN ITEMS 2 ON -1 true)
        run_case("invalid-${flag}-${value}" FALSE "-D${flag}=${value}")
    endforeach()
endforeach()
foreach(value IN ITEMS ON OFF TRUE FALSE YES NO Y N 1 0)
    run_case("cpu-${value}" TRUE "-DGGML_CPU_CYCLE_LOG:BOOL=${value}" -DLOG_CYCLE=0)
    if(value MATCHES "^(ON|TRUE|YES|Y|1)$")
        if(NOT CPU OR NOT LOG STREQUAL "0")
            message(FATAL_ERROR "CPU log true value changed independent log policy")
        endif()
    elseif(CPU OR NOT LOG STREQUAL "0")
        message(FATAL_ERROR "CPU log false value changed independent log policy")
    endif()
endforeach()
foreach(act IN ITEMS 0 1)
    foreach(res IN ITEMS 0 1)
        run_case("independent-${act}-${res}" TRUE "-DGGML_GEMMINI_ACT_QUANT_METRICS=${act}" "-DGGML_GEMMINI_RESIDUAL_METRICS=${res}" -DLOG_CYCLE=0)
        if(NOT ACT STREQUAL act OR NOT RES STREQUAL res OR NOT LOG STREQUAL "0")
            message(FATAL_ERROR "metric flags are not independent")
        endif()
    endforeach()
endforeach()
foreach(alias IN ITEMS 0 1)
    foreach(canonical IN ITEMS 0 1)
        run_case("alias-${alias}-${canonical}" TRUE "-DGGML_GEMMINI_ACT_METRICS=${alias}" "-DGGML_GEMMINI_ACT_QUANT_METRICS=${canonical}")
        if(alias OR canonical)
            set(expected 1)
        else()
            set(expected 0)
        endif()
        if(NOT ACT STREQUAL expected)
            message(FATAL_ERROR "activation metric alias changed")
        endif()
    endforeach()
endforeach()
foreach(arguments IN ITEMS "-DCYCLE_DETAIL=1;-DLOG_CYCLE=0" "-DGGML_GEMMINI_EXSIA_PROFILE_SCOPE=BAD" "-DGGML_GEMMINI_EXSIA_PROFILE_SCOPE=STAGE;-DCYCLE_DETAIL=0" "-DGGML_GEMMINI_EXECUTION_BACKEND=FPGA_UART")
    string(MAKE_C_IDENTIFIER "${arguments}" name)
    run_case("${name}" FALSE ${arguments})
endforeach()
set(ENV{FULL_C_DEFAULT} 0)
set(ENV{FULL_C} 1)
run_case(environment-precedence TRUE)
file(STRINGS "${root}/environment-precedence/CMakeCache.txt" full_c REGEX "^FULL_C:")
if(NOT full_c MATCHES "=1$")
    message(FATAL_ERROR "FULL_C environment did not override its environment default")
endif()
unset(ENV{FULL_C})
run_case(environment-default TRUE)
file(STRINGS "${root}/environment-default/CMakeCache.txt" full_c REGEX "^FULL_C:")
if(NOT full_c MATCHES "=0$")
    message(FATAL_ERROR "FULL_C environment default was not imported")
endif()
set(ENV{FULL_C} 1)
run_case(cli-precedence TRUE -DFULL_C:BOOL=0)
file(STRINGS "${root}/cli-precedence/CMakeCache.txt" full_c REGEX "^FULL_C:")
if(NOT full_c MATCHES "=0$")
    message(FATAL_ERROR "FULL_C CLI did not override its environment")
endif()
unset(ENV{FULL_C})
unset(ENV{FULL_C_DEFAULT})
foreach(source IN ITEMS GEMMINI_SW_PATH GEMMINI_SW_PATH_DEFAULT)
    set(ENV{${source}} /external-sdk-not-supported)
    run_case("${source}-disabled-rejected" FALSE)
    if(NOT CASE_DIAGNOSTIC MATCHES "GEMMINI_SW_PATH")
        message(FATAL_ERROR "Disabled backend SDK environment rejected for the wrong reason: ${CASE_DIAGNOSTIC}")
    endif()
    run_case("${source}-rejected" FALSE
        -DGGML_NPU=GEMMINI -DNPU_PRECISION=INT8 -DNPU_D=16
        -DNPU_SPAD_BANKS=4 -DNPU_SPAD_BANK_ROWS=4096
        -DNPU_ACC_BANKS=2 -DNPU_ACC_ROWS=1024 -DNPU_DMA_MAX_BYTES=64
        -DNPU_TRANSPORT=REFERENCE)
    if(NOT CASE_DIAGNOSTIC MATCHES "GEMMINI_SW_PATH")
        message(FATAL_ERROR "SDK environment rejected for the wrong reason: ${CASE_DIAGNOSTIC}")
    endif()
    unset(ENV{${source}})
endforeach()
