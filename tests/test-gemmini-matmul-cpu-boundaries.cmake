require_token("${compose}" "job.metrics_.compose_end_ns = now_ns();\n#if CYCLE_DETAIL && defined(__linux__) && defined(__aarch64__)\n        job.metrics_.telemetry_compose_end_sample = cycle::read_sample();" "Compose PMU end is adjacent to ns end")
require_token("${finalize}" "telemetry_residual_end_sample =\n                job.metrics_.telemetry_merge_end_sample" "Merge/residual end reuse")
require_token("${finalize}" "job.metrics_.cpu_work.merge.additive = false" "Merge non-additive")
require_token("${finalize}" "job.metrics_.telemetry_finalize_start_sample,\n            job.metrics_.telemetry_finalize_end_sample" "Finalize owns its exact endpoints")
require_token("${finalize}" "job.metrics_.cpu_work.finalize.cycles.reset();\n            job.metrics_.cpu_work.finalize.coverage = CpuWorkCoverage::invalid;\n            job.metrics_.cpu_work.finalize.additive = false;\n            job.metrics_.cpu_work.finalize.reason = \"failed_operation\";" "failed Merge invalidates Finalize atomically")
require_absent("${source}" "select_rmd_post_cpu_work" "dead post-selection seam")

