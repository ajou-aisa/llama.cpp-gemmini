{
  "version": 4,
  "configurePresets": [
    {
        "name":  "base",
        "hidden": true,
        "generator":   "Ninja",
        "binaryDir":   "${sourceDir}/build-${presetName}",
        "cacheVariables": {
            "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
            "CMAKE_INSTALL_RPATH": "$ORIGIN;$ORIGIN/.."
        }
    },
    {
        "name": "sycl-base",
        "hidden": true,
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/build-${presetName}",
        "cacheVariables": {
            "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
            "CMAKE_CXX_COMPILER": "icx",
            "CMAKE_C_COMPILER": "cl",
            "GGML_SYCL": "ON",
            "CMAKE_INSTALL_RPATH": "$ORIGIN;$ORIGIN/.."
        }
    },
    { "name": "debug",    "hidden": true, "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "release",  "hidden": true, "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "reldbg",   "hidden": true, "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" } },
    { "name": "static",   "hidden": true, "cacheVariables": { "GGML_STATIC":      "ON" } },
    { "name": "sycl_f16", "hidden": true, "cacheVariables": { "GGML_SYCL_F16":    "ON" } },
    { "name": "vulkan",   "hidden": true, "cacheVariables": { "GGML_VULKAN":      "ON" } },

    {
        "name": "npu-gemmini-int8-d16", "hidden": true,
        "description": "Gemmini INT8 D16 (gemmini-aisa 185293e8 default config)",
        "cacheVariables": {
            "GGML_NPU": "GEMMINI", "NPU_PRECISION": "INT8", "NPU_D": "16",
            "NPU_SPAD_BANKS": "4", "NPU_SPAD_BANK_ROWS": "4096", "NPU_ACC_BANKS": "2", "NPU_ACC_ROWS": "1024",
            "NPU_DMA_MAX_BYTES": "64"
        }
    },
    {
        "name": "npu-potal-int8-d16", "hidden": true,
        "description": "PoTAL INT8 D16 (chipyard-aisa potal fab3d262, gemmini_potal_params.h)",
        "cacheVariables": {
            "GGML_NPU": "POTAL", "NPU_PRECISION": "INT8", "NPU_D": "16",
            "NPU_SPAD_BANKS": "4", "NPU_SPAD_BANK_ROWS": "4096", "NPU_ACC_BANKS": "2", "NPU_ACC_ROWS": "1024",
            "NPU_INDEX_ENTRIES": "32", "NPU_SCALE_ENTRIES": "256", "NPU_DMA_MAX_BYTES": "64"
        }
    },
    {
        "name": "npu-potal-int8-d32", "hidden": true,
        "description": "PoTAL INT8 D32 (gemmini_potal_d32_params.h)",
        "cacheVariables": {
            "GGML_NPU": "POTAL", "NPU_PRECISION": "INT8", "NPU_D": "32",
            "NPU_SPAD_BANKS": "4", "NPU_SPAD_BANK_ROWS": "2048", "NPU_ACC_BANKS": "2", "NPU_ACC_ROWS": "512",
            "NPU_INDEX_ENTRIES": "64", "NPU_SCALE_ENTRIES": "256", "NPU_DMA_MAX_BYTES": "64"
        }
    },
    {
        "name": "npu-potal-int8-d64", "hidden": true,
        "description": "PoTAL INT8 D64 (gemmini_potal_d64_params.h)",
        "cacheVariables": {
            "GGML_NPU": "POTAL", "NPU_PRECISION": "INT8", "NPU_D": "64",
            "NPU_SPAD_BANKS": "4", "NPU_SPAD_BANK_ROWS": "1024", "NPU_ACC_BANKS": "2", "NPU_ACC_ROWS": "256",
            "NPU_INDEX_ENTRIES": "128", "NPU_SCALE_ENTRIES": "256", "NPU_DMA_MAX_BYTES": "64"
        }
    },
    {
        "name": "npu-potal-int4-d32", "hidden": true,
        "description": "PoTAL INT4 D32 packing ABI 1 (gemmini_potal_w4a4_d32_params.h)",
        "cacheVariables": {
            "GGML_NPU": "POTAL", "NPU_PRECISION": "INT4", "NPU_D": "32",
            "NPU_SPAD_BANKS": "4", "NPU_SPAD_BANK_ROWS": "2048", "NPU_ACC_BANKS": "2", "NPU_ACC_ROWS": "512",
            "NPU_INDEX_ENTRIES": "64", "NPU_SCALE_ENTRIES": "256", "NPU_DMA_MAX_BYTES": "64"
        }
    },
    {
        "name": "npu-gemmini-fp32-d8", "hidden": true,
        "description": "Independent FP32 comparison baseline; requires an explicit DIM8 SDK overlay and its memory geometry",
        "cacheVariables": {
            "GGML_NPU": "GEMMINI", "NPU_PRECISION": "FP32", "NPU_D": "8",
            "GGML_GEMMINI_FP32": "ON", "GEMMINI_SW_PATH": "$env{GEMMINI_FP32_SDK}",
            "NPU_SPAD_BANKS": "$env{FP32_SPAD_BANKS}", "NPU_SPAD_BANK_ROWS": "$env{FP32_SPAD_BANK_ROWS}",
            "NPU_ACC_BANKS": "$env{FP32_ACC_BANKS}", "NPU_ACC_ROWS": "$env{FP32_ACC_ROWS}",
            "NPU_DMA_MAX_BYTES": "64", "GGML_GEMMINI_PB": "OFF",
            "GGML_GEMMINI_COMPUTE_TYPE": "FLOAT", "GGML_GEMMINI_OPTION": "WS",
            "GGML_GEMMINI_ENABLE_RMD": "OFF", "GGML_GEMMINI_ENABLE_A4NKS_ATTENTION": "OFF",
            "GGML_OPENMP": "OFF", "GGML_GEMMINI_ENABLE_OPENMP": "OFF"
        }
    },
    { "name": "gemmini-fp32-d8-reference", "inherits": [ "base", "release", "npu-gemmini-fp32-d8", "npu-reference" ] },
    { "name": "gemmini-fp32-d8-rocc", "inherits": [ "base", "release", "npu-gemmini-fp32-d8", "npu-rocc" ] },
    { "name": "npu-reference", "hidden": true, "cacheVariables": { "NPU_TRANSPORT": "REFERENCE", "LLAMA_BUILD_TESTS": "ON" } },
    {
        "name": "npu-rocc", "hidden": true,
        "cacheVariables": {
            "NPU_TRANSPORT": "ROCC",
            "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/riscv64-linux.cmake"
        }
    },
    {
        "name": "npu-gemmini-int8-d32-pb", "hidden": true,
        "inherits": [ "npu-gemmini-int8-d16" ],
        "description": "PB D32 software geometry, matching the verified RISC-V cross-build; hardware deployment unverified",
        "cacheVariables": {
            "NPU_D": "32", "NPU_MATMUL_ALGORITHM": "PARTIAL_SUM",
            "GGML_GEMMINI_COMPUTE_TYPE": "INT",
            "GGML_GEMMINI_ACTIVATION_BITS": "8", "GGML_GEMMINI_WEIGHT_BITS": "8",
            "GGML_GEMMINI_ACTIVATION_QUANT": "BLOCK", "GGML_GEMMINI_BLOCK_SIZE": "32",
            "GGML_GEMMINI_ENABLE_RMD": "OFF"
        }
    },
    { "name": "gemmini-int8-d32-pb-reference", "inherits": [ "base", "release", "npu-gemmini-int8-d32-pb", "npu-reference" ] },
    { "name": "gemmini-int8-d32-pb-rocc",      "inherits": [ "base", "release", "npu-gemmini-int8-d32-pb", "npu-rocc" ] },
    { "name": "gemmini-int8-d16-reference", "inherits": [ "base", "release", "npu-gemmini-int8-d16", "npu-reference" ] },
    { "name": "gemmini-int8-d16-rocc",      "inherits": [ "base", "release", "npu-gemmini-int8-d16", "npu-rocc" ] },
    { "name": "potal-int8-d16-reference",   "inherits": [ "base", "release", "npu-potal-int8-d16", "npu-reference" ] },
    { "name": "potal-int8-d16-rocc",        "inherits": [ "base", "release", "npu-potal-int8-d16", "npu-rocc" ] },
    { "name": "potal-int8-d32-reference",   "inherits": [ "base", "release", "npu-potal-int8-d32", "npu-reference" ] },
    { "name": "potal-int8-d32-rocc",        "inherits": [ "base", "release", "npu-potal-int8-d32", "npu-rocc" ] },
    { "name": "potal-int8-d64-reference",   "inherits": [ "base", "release", "npu-potal-int8-d64", "npu-reference" ] },
    { "name": "potal-int4-d32-reference",   "inherits": [ "base", "release", "npu-potal-int4-d32", "npu-reference" ] },
    { "name": "potal-int4-d32-rocc",        "inherits": [ "base", "release", "npu-potal-int4-d32", "npu-rocc" ] },

    {
        "name": "x64-windows-llvm", "hidden": true,
        "cacheVariables": {
            "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/x64-windows-llvm.cmake"
        }
    },

    {
        "name": "arm64-windows-llvm", "hidden": true,
        "architecture": { "value": "arm64",    "strategy": "external" },
        "toolset":      { "value": "host=x64", "strategy": "external" },
        "cacheVariables": {
            "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/arm64-windows-llvm.cmake"
        }
    },

    {
        "name": "arm64-apple-clang", "hidden": true,
        "architecture": { "value": "arm64",    "strategy": "external" },
        "toolset":      { "value": "host=x64", "strategy": "external" },
        "cacheVariables": {
            "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/arm64-apple-clang.cmake"
        }
    },

    { "name": "arm64-windows-llvm-debug", "inherits": [ "base", "arm64-windows-llvm", "debug" ] },
    { "name": "arm64-windows-llvm-release", "inherits": [ "base", "arm64-windows-llvm", "reldbg" ] },
    { "name": "arm64-windows-llvm+static-release", "inherits": [ "base", "arm64-windows-llvm", "reldbg", "static" ] },

    { "name": "arm64-apple-clang-debug", "inherits": [ "base", "arm64-apple-clang", "debug" ] },
    { "name": "arm64-apple-clang-release", "inherits": [ "base", "arm64-apple-clang", "reldbg" ] },
    { "name": "arm64-apple-clang+static-release", "inherits": [ "base", "arm64-apple-clang",  "reldbg", "static" ] },

    { "name": "x64-windows-llvm-debug", "inherits": [ "base", "x64-windows-llvm", "debug" ] },
    { "name": "x64-windows-llvm-release", "inherits": [ "base", "x64-windows-llvm", "release" ] },
    { "name": "x64-windows-llvm-reldbg", "inherits": [ "base", "x64-windows-llvm", "reldbg" ] },
    { "name": "x64-windows-llvm+static-release", "inherits": [ "base", "x64-windows-llvm", "reldbg", "static" ] },

    { "name": "x64-windows-msvc-debug", "inherits": [ "base", "debug" ] },
    { "name": "x64-windows-msvc-release", "inherits": [ "base", "reldbg" ] },
    { "name": "x64-windows-msvc+static-release", "inherits": [ "base", "reldbg", "static" ] },

    { "name": "x64-windows-sycl-debug", "inherits": [ "sycl-base", "debug" ] },
    { "name": "x64-windows-sycl-debug-f16", "inherits": [ "sycl-base", "debug", "sycl_f16" ] },
    { "name": "x64-windows-sycl-release", "inherits": [ "sycl-base", "release" ] },
    { "name": "x64-windows-sycl-release-f16", "inherits": [ "sycl-base", "release", "sycl_f16" ] },

    { "name": "x64-windows-vulkan-debug", "inherits": [ "base", "vulkan", "debug" ] },
    { "name": "x64-windows-vulkan-release", "inherits": [ "base", "vulkan", "release" ] }
  ]
}
