require_token("${rmd}" "telemetry_backend_start_sample = backend_start_sample" "backend start reuse")
require_token("${rmd}" "telemetry_backend_end_sample = backend_end_sample" "backend end reuse")
require_token("${compose}" "job.direct_residual_ != nullptr || packet == nullptr" "direct Compose exclusion")
