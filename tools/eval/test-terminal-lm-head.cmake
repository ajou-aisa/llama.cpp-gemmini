# A metric-only terminal lm_head is refused outside a METRIC_PREFILL_256 metric collection, before any input opens.
if(NOT DEFINED RUNNER OR NOT DEFINED TEST_OUTPUT_DIR)
    message(FATAL_ERROR "RUNNER and TEST_OUTPUT_DIR are required")
endif()
set(inputs --model "${TEST_OUTPUT_DIR}/missing-model.gguf" --file "${TEST_OUTPUT_DIR}/missing-dataset.txt"
    --output-dir "${TEST_OUTPUT_DIR}/native")
set(limited "limited to a METRIC_PREFILL_256 metric collection")
foreach(case IN ITEMS generation forced-replay no-sink value)
    if(case STREQUAL "generation")
        set(extra --workload E2E_GENERATION_256_128 --chunk-index 0 --terminal-lm-head metrics-only)
        set(expected "${limited}")
    elseif(case STREQUAL "forced-replay")
        set(extra --forced-token-ids "${TEST_OUTPUT_DIR}/forced.json" --terminal-lm-head metrics-only)
        set(expected "${limited}")
    elseif(case STREQUAL "no-sink")
        set(extra --terminal-lm-head metrics-only)
        set(expected "requires a metric sink|limited to a METRIC_PREFILL_256|requires the IM2P_SIM")
    else()
        set(extra --terminal-lm-head partial)
        set(expected "--terminal-lm-head full\\|metrics-only")
    endif()
    execute_process(COMMAND "${RUNNER}" ${inputs} ${extra}
        RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(code EQUAL 0 OR NOT stderr MATCHES "${expected}")
        message(FATAL_ERROR "terminal lm_head ${case} must be refused: ${stdout}${stderr}")
    endif()
endforeach()
if(EXISTS "${TEST_OUTPUT_DIR}/native")
    message(FATAL_ERROR "a refused terminal lm_head request created an output path")
endif()
message(STATUS "metric-only terminal lm_head refused for generation, forced replay, no sink and unknown modes")
